{
  "info": {
    "name": "MediBook API",
    "description": "Local MediBook REST API checks. Run Login first to store the bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "doctorId", "value": "3" },
    { "key": "appointmentId", "value": "1" },
    { "key": "appointmentStart", "value": "2027-01-04T04:00:00Z" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        { "name": "Register patient", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Demo Patient\",\n  \"email\": \"new.patient@example.com\",\n  \"password\": \"DemoPassword123\",\n  \"role\": \"PATIENT\"\n}" }, "url": "{{baseUrl}}/api/auth/register" } },
        { "name": "Login patient", "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) pm.environment.set('token', pm.response.json().token);"], "type": "text/javascript" } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient@medibook.local\",\n  \"password\": \"password\"\n}" }, "url": "{{baseUrl}}/api/auth/login" } }
      ]
    },
    { "name": "Browse doctors", "request": { "method": "GET", "url": "{{baseUrl}}/api/doctors?specialty=Cardiology&location=Bengaluru&page=0&size=10&sortBy=fee&direction=asc" } },
    { "name": "Doctor slots", "request": { "method": "GET", "url": "{{baseUrl}}/api/doctors/{{doctorId}}/availability?date=2027-01-04" } },
    {
      "name": "Patient appointments",
      "item": [
        { "name": "Book appointment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"doctorId\": {{doctorId}},\n  \"startAt\": \"{{appointmentStart}}\",\n  \"reason\": \"Routine consultation\"\n}" }, "url": "{{baseUrl}}/api/appointments" } },
        { "name": "My appointments", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/appointments/me" } },
        { "name": "Reschedule appointment", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"startAt\": \"{{appointmentStart}}\"\n}" }, "url": "{{baseUrl}}/api/appointments/{{appointmentId}}/reschedule" } },
        { "name": "Cancel appointment", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/appointments/{{appointmentId}}/cancel" } }
      ]
    },
    { "name": "Admin dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/admin/dashboard" } }
  ]
}
