# MediBook Terraform Configuration Variables Example
# Copy this file to 'terraform.tfvars' to customize values locally.
# DO NOT commit 'terraform.tfvars' containing sensitive IPs to version control.

aws_region                = "ap-south-1"
project_name              = "medibook"
environment               = "production"
instance_type             = "t2.micro"

# Restrict SSH (Port 22) access to your personal public IP address for security.
# Use your own public IP with a /32 suffix. An empty list creates no SSH rule.
trusted_ssh_cidr          = ["203.0.113.25/32"]

# Set to true to automatically generate a dedicated key pair (medibook-key.pem).
enable_ssh_key_generation = true

# If enable_ssh_key_generation is false, specify an existing AWS key pair name:
# existing_key_pair_name  = "ansible-key.pem"

root_volume_size          = 20
root_volume_type          = "gp3"
