# Local development defaults only. Use unique credentials and a long random JWT secret outside local demos.
POSTGRES_DB=medibook
POSTGRES_USER=medibook
POSTGRES_PASSWORD=change-this-local-password-before-use
SPRING_PROFILES_ACTIVE=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
APP_PORT=5173
CANCELLATION_HOURS=24
TIMEZONE=Asia/Kolkata
# Optional SMTP integration is not enabled unless SMTP_HOST is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@medibook.local
